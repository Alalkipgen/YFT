<resources>
    <!-- Dark system theme: Night window background and light status-bar icons before Compose
         draws, so a dark start never flashes white. -->
    <style name="Theme.Yft" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/yft_window_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
</resources>
