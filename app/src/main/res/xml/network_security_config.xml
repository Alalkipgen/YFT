<?xml version="1.0" encoding="utf-8"?>
<!--
    Every build type: HTTPS only, and only the system's trusted certificate authorities.
    User-installed CAs are not trusted, so a device-level proxy certificate cannot read
    browser sessions or download links.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
