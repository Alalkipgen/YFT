# Local release signing (docs/RELEASE.md). Copy this file to keystore.properties, which Git
# ignores, and fill it in on your own machine. Never commit the copy or paste its values anywhere.
# Relative storeFile paths are resolved from the repository root; keep the keystore outside it.
storeFile=/path/outside/the/repository/yft-release.jks
storePassword=
keyAlias=yft-release
keyPassword=
